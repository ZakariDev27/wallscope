{
  "version": "2026.11",
  "signatures": [
    {
      "name": "Cloudflare",
      "vendor": "Cloudflare, Inc.",
      "kind": "cdn-waf",
      "matchers": [
        { "type": "header", "name": "server", "pattern": "^cloudflare", "weight": 40 },
        { "type": "header", "name": "cf-ray", "pattern": ".+", "weight": 40 },
        { "type": "header", "name": "cf-mitigated", "pattern": ".+", "weight": 60 },
        { "type": "cookie", "pattern": "^(__cf_bm|cf_clearance|__cfruid)=", "weight": 30 },
        { "type": "body", "pattern": "Attention Required! \\| Cloudflare|cf-error-details|Sorry, you have been blocked", "weight": 60 }
      ]
    },
    {
      "name": "AWS WAF / CloudFront",
      "vendor": "Amazon Web Services",
      "kind": "cdn-waf",
      "matchers": [
        { "type": "header", "name": "x-amzn-waf-action", "pattern": ".+", "weight": 80 },
        { "type": "header", "name": "x-amz-cf-id", "pattern": ".+", "weight": 30 },
        { "type": "header", "name": "server", "pattern": "^(CloudFront|awselb)", "weight": 30 },
        { "type": "header", "name": "x-amzn-errortype", "pattern": "ForbiddenException|AccessDenied", "weight": 30 },
        { "type": "cookie", "pattern": "^(aws-waf-token|AWSALB|AWSALBCORS)=", "weight": 30 },
        { "type": "body", "pattern": "Request blocked\\.\\s+We can't connect to the server|Generated by cloudfront \\(CloudFront\\)", "weight": 50 }
      ]
    },
    {
      "name": "Akamai",
      "vendor": "Akamai Technologies",
      "kind": "cdn-waf",
      "matchers": [
        { "type": "header", "name": "server", "pattern": "AkamaiGHost|AkamaiNetStorage", "weight": 50 },
        { "type": "header", "name": "x-akamai-transformed", "pattern": ".+", "weight": 40 },
        { "type": "header", "name": "akamai-grn", "pattern": ".+", "weight": 50 },
        { "type": "cookie", "pattern": "^(ak_bmsc|bm_sz|bm_sv|_abck)=", "weight": 40 },
        { "type": "body", "pattern": "Access Denied[\\s\\S]{0,400}Reference&#32;&#35;|errors\\.edgesuite\\.net", "weight": 60 }
      ]
    },
    {
      "name": "Imperva Incapsula",
      "vendor": "Imperva",
      "kind": "waf",
      "matchers": [
        { "type": "header", "name": "x-iinfo", "pattern": ".+", "weight": 60 },
        { "type": "header", "name": "x-cdn", "pattern": "Incapsula|Imperva", "weight": 60 },
        { "type": "cookie", "pattern": "^(incap_ses_|visid_incap_|nlbi_)", "weight": 50 },
        { "type": "body", "pattern": "Incapsula incident ID|_Incapsula_Resource", "weight": 60 }
      ]
    },
    {
      "name": "F5 BIG-IP ASM / Advanced WAF",
      "vendor": "F5, Inc.",
      "kind": "waf",
      "matchers": [
        { "type": "header", "name": "server", "pattern": "^(BigIP|BIG-IP|F5)", "weight": 40 },
        { "type": "cookie", "pattern": "^BIGipServer", "weight": 30 },
        { "type": "cookie", "pattern": "^TS[0-9a-f]{6,}=", "weight": 40 },
        { "type": "body", "pattern": "The requested URL was rejected\\. Please consult with your administrator|Your support ID is", "weight": 70 }
      ]
    },
    {
      "name": "Sucuri CloudProxy",
      "vendor": "Sucuri (GoDaddy)",
      "kind": "waf",
      "matchers": [
        { "type": "header", "name": "server", "pattern": "Sucuri", "weight": 60 },
        { "type": "header", "name": "x-sucuri-id", "pattern": ".+", "weight": 60 },
        { "type": "header", "name": "x-sucuri-cache", "pattern": ".+", "weight": 40 },
        { "type": "body", "pattern": "Sucuri WebSite Firewall|cloudproxy@sucuri\\.net", "weight": 60 }
      ]
    },
    {
      "name": "ModSecurity",
      "vendor": "OWASP / Trustwave",
      "kind": "waf",
      "matchers": [
        { "type": "header", "name": "server", "pattern": "mod_security|Mod_Security|NOYB", "weight": 60 },
        { "type": "body", "pattern": "This error was generated by Mod_Security|ModSecurity Action|rejected by the security rules", "weight": 70 },
        { "type": "body", "pattern": "<title>406 Not Acceptable</title>|Not Acceptable!", "weight": 30 }
      ]
    },
    {
      "name": "Azure Front Door / Application Gateway WAF",
      "vendor": "Microsoft",
