        { "type": "header", "name": "server", "pattern": "Microsoft-Azure-Application-Gateway", "weight": 60 },
        { "type": "cookie", "pattern": "^ApplicationGatewayAffinity", "weight": 30 },
        { "type": "body", "pattern": "Microsoft-Azure-Application-Gateway|The request is blocked\\.", "weight": 50 }
